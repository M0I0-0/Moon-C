# --- Ollama (small talk only) ---
MOON_C_OLLAMA_URL=http://localhost:11434
MOON_C_OLLAMA_MODEL=qwen3.5:4b
# Seconds to wait for a small-talk reply before using a canned reply.
MOON_C_OLLAMA_TIMEOUT_S=10
MOON_C_OLLAMA_KEEP_ALIVE=30m
MOON_C_OLLAMA_NUM_PREDICT=120
MOON_C_OLLAMA_TEMPERATURE=0.7
# Load the model in the background when the backend starts.
MOON_C_OLLAMA_WARMUP=true

# --- Data ---
# Folder with protocols.json, keywords.json and crew.json (default: ../shared).
# MOON_C_SHARED_DIR=../shared
# Measurements file (default: backend/storage/measurements.json).
# MOON_C_STORAGE_PATH=storage/measurements.json
# Days to keep measurements. 0 = keep for the whole mission.
MOON_C_RETENTION_DAYS=0

# --- Chat sessions (memory only, never persisted) ---
MOON_C_SESSION_TTL_S=600
MOON_C_SESSION_MAX_TURNS=10

# --- Earth link (simulated) ---
# offline: data waits in the queue until POST /sync/simulate.
# online: pending measurements are marked as synced in the background.
MOON_C_EARTH_LINK=offline
MOON_C_SYNC_INTERVAL_S=60

# --- Simulated bracelets (live vital signs; there are no real sensors yet) ---
# false = no live signs (GET /vitals returns an empty list).
MOON_C_SIMULATION=true
# Seconds between simulated readings.
MOON_C_SIM_TICK_S=2.5
# Seconds between stored snapshots of the live signs (status changes are always stored).
MOON_C_SNAPSHOT_INTERVAL_S=900
# Fixed random seed for reproducible demos (empty = random).
# MOON_C_SIM_SEED=7

# --- CORS (frontend origins) ---
MOON_C_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Any localhost port is also allowed by this regex. Set it to an empty value to disable.
MOON_C_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
