# URL del backend de Moon-C (FastAPI). Si no responde, la app usa respuestas simuladas.
VITE_API_URL=http://localhost:8000

# Modelos 3D servidos desde public/models. Formatos: .glb, .gltf o .stl. Vacío = modelo por defecto.
# Asistente (centro, siempre mirando a la cámara). Vacío = personaje Moon-C de ../Model3D/moonc.
VITE_ASSISTANT_MODEL_URL=
# Pon false si tus STL ya vienen con Y hacia arriba (por defecto se asume Z arriba).
VITE_STL_Z_UP=true

# Giro en grados si un modelo aparece de espaldas (por ejemplo 180).
VITE_ASSISTANT_MODEL_YAW=0
